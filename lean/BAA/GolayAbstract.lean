import BAA.Golay
import Mathlib.LinearAlgebra.Matrix.ToLin

/-!
# Abstract realization of the extended Golay code
-/

namespace BAA

def golayUnextend (y : BitVec 24) : BitVec 23 :=
  BitVec.ofNat 23 y.toNat

theorem golayUnextend_parityExtend (x : BitVec 23) :
    golayUnextend (golayParityExtend x) = x := by
  apply BitVec.toNat_injective
  simp [golayUnextend, golayParityExtend, BitVec.toNat_ofNat]
  exact x.isLt

theorem golayParityExtend_injective : Function.Injective golayParityExtend :=
  Function.LeftInverse.injective golayUnextend_parityExtend

theorem golayEncode_injective : Function.Injective golayEncode :=
  golayParityExtend_injective.comp golayCyclicEncode_injective

def golayMessageRow (j : Fin 12) : BitVec 12 :=
  BitVec.ofNat 12 (2 ^ j.val)

def golayRowWord (j : Fin 12) : BinaryWord 24 :=
  bitVecToWord (golayEncode (golayMessageRow j))

/-- Abstract linear encoder generated by the cyclic rows and their parity
extensions. -/
def golayLinearMap : BinaryWord 12 →ₗ[ZMod 2] BinaryWord 24 where
  toFun m i := ∑ j : Fin 12, m j * golayRowWord j i
  map_add' x y := by
    funext i
    simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
  map_smul' c x := by
    funext i
    simp [Finset.mul_sum, mul_assoc]

/-- The first twelve coordinates of the generator matrix. -/
def golayLowMatrix : Matrix (Fin 12) (Fin 12) (ZMod 2) :=
  fun i j => golayRowWord j (Fin.castLE (by omega) i)

/-- The inverse-series matrix induced by `0x49F`. -/
def golayLowInverseMatrix : Matrix (Fin 12) (Fin 12) (ZMod 2) :=
  fun i j =>
    if (BitVec.ofNat 12 (0x49F * 2 ^ j.val)).getLsb i then 1 else 0

/-- The 12-by-12 low-coordinate generator matrix is invertible.  This small
constant matrix certificate replaces a quadratic search over all messages. -/
theorem golayLowInverseMatrix_mul :
    golayLowInverseMatrix * golayLowMatrix = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> decide

theorem golayLowMatrix_mulVec (x : BinaryWord 12) (i : Fin 12) :
    golayLowMatrix.mulVec x i =
      golayLinearMap x (Fin.castLE (by omega) i) := by
  simp [golayLowMatrix, Matrix.mulVec, dotProduct, golayLinearMap, mul_comm]

theorem golayLowMatrix_mulVec_injective :
    Function.Injective golayLowMatrix.mulVec := by
  intro x y hxy
  have h := congrArg golayLowInverseMatrix.mulVec hxy
  calc
    x = (1 : Matrix (Fin 12) (Fin 12) (ZMod 2)).mulVec x :=
      (Matrix.one_mulVec x).symm
    _ = (golayLowInverseMatrix * golayLowMatrix).mulVec x := by
      rw [golayLowInverseMatrix_mul]
    _ = golayLowInverseMatrix.mulVec (golayLowMatrix.mulVec x) :=
      (Matrix.mulVec_mulVec x golayLowInverseMatrix golayLowMatrix).symm
    _ = golayLowInverseMatrix.mulVec (golayLowMatrix.mulVec y) := h
    _ = (golayLowInverseMatrix * golayLowMatrix).mulVec y :=
      Matrix.mulVec_mulVec y golayLowInverseMatrix golayLowMatrix
    _ = (1 : Matrix (Fin 12) (Fin 12) (ZMod 2)).mulVec y := by
      rw [golayLowInverseMatrix_mul]
    _ = y := Matrix.one_mulVec y

theorem golayLinearMap_injective : Function.Injective golayLinearMap := by
  intro x y hxy
  apply golayLowMatrix_mulVec_injective
  funext i
  rw [golayLowMatrix_mulVec, golayLowMatrix_mulVec]
  exact congrFun hxy (Fin.castLE (by omega) i)

def golayCode : Code (ZMod 2) 24 := golayLinearMap.range

theorem finrank_golayCode : Module.finrank (ZMod 2) golayCode = 12 := by
  rw [golayCode, golayLinearMap.finrank_range_of_inj golayLinearMap_injective]
  simpa [BinaryWord, Word] using
    (Module.finrank_fin_fun (R := ZMod 2) (n := 12))

end BAA
