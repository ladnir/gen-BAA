import BAA.ConcreteBinary

/-!
# The appendix `[32,8,12]` binary code

The hexadecimal constants are decoded least-significant-bit first.  The
encoder is deliberately unrolled: it is both the small trusted specification
and the performance-conscious executable used by exhaustive certificates.
-/

namespace BAA

def appendixRow0 : BitVec 32 := BitVec.ofNat 32 0xFFFFFFFF
def appendixRow1 : BitVec 32 := BitVec.ofNat 32 0xB7DC4AE7
def appendixRow2 : BitVec 32 := BitVec.ofNat 32 0xAA9D2399
def appendixRow3 : BitVec 32 := BitVec.ofNat 32 0x60E73723
def appendixRow4 : BitVec 32 := BitVec.ofNat 32 0x6844CC86
def appendixRow5 : BitVec 32 := BitVec.ofNat 32 0x180D3C68
def appendixRow6 : BitVec 32 := BitVec.ofNat 32 0x52610E07
def appendixRow7 : BitVec 32 := BitVec.ofNat 32 0x19DE6790

private def selectRow (b : Bool) (row : BitVec 32) : BitVec 32 :=
  if b then row else BitVec.ofNat 32 0

def appendixEncode (m : BitVec 8) : BitVec 32 :=
  BitVec.xor (selectRow (m.getLsbD 0) appendixRow0) <|
  BitVec.xor (selectRow (m.getLsbD 1) appendixRow1) <|
  BitVec.xor (selectRow (m.getLsbD 2) appendixRow2) <|
  BitVec.xor (selectRow (m.getLsbD 3) appendixRow3) <|
  BitVec.xor (selectRow (m.getLsbD 4) appendixRow4) <|
  BitVec.xor (selectRow (m.getLsbD 5) appendixRow5) <|
  BitVec.xor (selectRow (m.getLsbD 6) appendixRow6) <|
    selectRow (m.getLsbD 7) appendixRow7

/-- Kernel-reduced injectivity certificate on the canonical 256-message
enumeration. -/
theorem appendixEncodeFin_injective : Function.Injective
    (fun m : Fin 256 => appendixEncode (BitVec.ofNat 8 m.val)) := by
  set_option maxRecDepth 100000 in
    decide

/-- The eight printed rows are independent, expressed as injectivity of their
unrolled bit-vector encoder. -/
theorem appendixEncode_injective : Function.Injective appendixEncode := by
  intro x y hxy
  let xf : Fin 256 := ⟨x.toNat, by simpa using x.isLt⟩
  let yf : Fin 256 := ⟨y.toNat, by simpa using y.isLt⟩
  have hfin : xf = yf := appendixEncodeFin_injective (by
    simpa [xf, yf] using hxy)
  exact BitVec.toNat_injective (congrArg Fin.val hfin)

def appendixWeightCount (w : ℕ) : ℕ :=
  (Finset.univ.filter fun m : Fin 256 =>
    bitVecWeight (appendixEncode (BitVec.ofNat 8 m.val)) = w).card

def appendixExpectedWeightCount (w : ℕ) : ℕ :=
  if w = 0 then 1
  else if w = 12 then 48
  else if w = 16 then 158
  else if w = 20 then 48
  else if w = 32 then 1
  else 0

/-- Kernel-reduced exhaustive certificate for the complete 256-word spectrum.
The bounded index covers every possible weight at length 32. -/
theorem appendixWeightSpectrum :
    ∀ w : Fin 33, appendixWeightCount w.val = appendixExpectedWeightCount w.val := by
  set_option maxRecDepth 100000 in
    decide

theorem appendixMinimumWeight :
    (∀ m : Fin 256, m ≠ 0 →
      12 ≤ bitVecWeight (appendixEncode (BitVec.ofNat 8 m.val))) ∧
    (∃ m : Fin 256,
      bitVecWeight (appendixEncode (BitVec.ofNat 8 m.val)) = 12) := by
  set_option maxRecDepth 100000 in
    decide

/-- The concrete output weight used in the exhaustive certificate is exactly
the abstract Hamming weight after conversion. -/
theorem appendixEncode_weight_bridge (m : BitVec 8) :
    hammingNorm (bitVecToWord (appendixEncode m)) =
      bitVecWeight (appendixEncode m) :=
  hammingNorm_bitVecToWord _

/-! ## Abstract linear-code realization -/

/-- The printed hexadecimal rows, now interpreted as abstract binary words. -/
def appendixRowWord : Fin 8 → BinaryWord 32 :=
  ![bitVecToWord appendixRow0, bitVecToWord appendixRow1,
    bitVecToWord appendixRow2, bitVecToWord appendixRow3,
    bitVecToWord appendixRow4, bitVecToWord appendixRow5,
    bitVecToWord appendixRow6, bitVecToWord appendixRow7]

/-- Abstract linear encoder generated by the eight appendix rows. -/
def appendixLinearMap : BinaryWord 8 →ₗ[ZMod 2] BinaryWord 32 where
  toFun m i := ∑ j : Fin 8, m j * appendixRowWord j i
  map_add' x y := by
    funext i
    simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
  map_smul' c x := by
    funext i
    simp [Finset.mul_sum, mul_assoc]

/-- Coordinatewise kernel certificate relating the unrolled encoder to the
abstract row sum. -/
theorem appendixLinearMap_bridge_coord :
    ∀ m : Fin 256, ∀ i : Fin 32,
      appendixLinearMap (bitVecToWord (BitVec.ofNat 8 m.val)) i =
        bitVecToWord (appendixEncode (BitVec.ofNat 8 m.val)) i := by
  set_option maxRecDepth 100000 in
  decide

/-- The unrolled `BitVec` encoder and the abstract linear map compute the same
word.  This finite bridge is kernel-reduced, not a native-code axiom. -/
theorem appendixLinearMap_bridge (m : BitVec 8) :
    appendixLinearMap (bitVecToWord m) = bitVecToWord (appendixEncode m) := by
  funext i
  let mf : Fin 256 := ⟨m.toNat, by simpa using m.isLt⟩
  simpa [mf] using appendixLinearMap_bridge_coord mf i

theorem appendixLinearMap_injective : Function.Injective appendixLinearMap := by
  intro x y hxy
  let bx := wordToBitVec x
  let byv := wordToBitVec y
  have hwords : bitVecToWord (appendixEncode bx) =
      bitVecToWord (appendixEncode byv) := by
    rw [← appendixLinearMap_bridge, ← appendixLinearMap_bridge,
      bitVecToWord_wordToBitVec, bitVecToWord_wordToBitVec]
    exact hxy
  have hbits : appendixEncode bx = appendixEncode byv :=
    bitVecToWord_injective hwords
  have hbxy : bx = byv := appendixEncode_injective hbits
  calc
    x = bitVecToWord bx := (bitVecToWord_wordToBitVec x).symm
    _ = bitVecToWord byv := congrArg bitVecToWord hbxy
    _ = y := bitVecToWord_wordToBitVec y

/-- The appendix code as a submodule of the abstract word space. -/
def appendixCode : Code (ZMod 2) 32 := appendixLinearMap.range

theorem finrank_appendixCode : Module.finrank (ZMod 2) appendixCode = 8 := by
  rw [appendixCode, appendixLinearMap.finrank_range_of_inj appendixLinearMap_injective]
  simpa [BinaryWord, Word] using
    (Module.finrank_fin_fun (R := ZMod 2) (n := 8))

theorem appendixCode_weight_lower (c : appendixCode) (hc : c ≠ 0) :
    12 ≤ hammingNorm (c : BinaryWord 32) := by
  obtain ⟨m, hm⟩ := c.2
  have hm0 : m ≠ 0 := by
    intro hmzero
    apply hc
    apply Subtype.ext
    rw [← hm]
    simp [hmzero]
  let b := wordToBitVec m
  have hb0 : b ≠ 0 := by
    intro hbzero
    apply hm0
    calc
      m = bitVecToWord b := (bitVecToWord_wordToBitVec m).symm
      _ = 0 := by
        rw [hbzero]
        funext i
        simp [bitVecToWord]
  let mf : Fin 256 := ⟨b.toNat, by simpa using b.isLt⟩
  have hmf0 : mf ≠ 0 := by
    intro hzero
    apply hb0
    apply BitVec.toNat_injective
    have hv := congrArg Fin.val hzero
    simpa [mf] using hv
  have hcert := appendixMinimumWeight.1 mf hmf0
  have henc : appendixLinearMap m = bitVecToWord (appendixEncode b) := by
    rw [← bitVecToWord_wordToBitVec m]
    exact appendixLinearMap_bridge b
  calc
    12 ≤ bitVecWeight (appendixEncode (BitVec.ofNat 8 mf.val)) := hcert
    _ = bitVecWeight (appendixEncode b) := by simp [mf]
    _ = hammingNorm (bitVecToWord (appendixEncode b)) :=
      (hammingNorm_bitVecToWord _).symm
    _ = hammingNorm (appendixLinearMap m) := congrArg hammingNorm henc.symm
    _ = hammingNorm (c : BinaryWord 32) := congrArg hammingNorm hm

theorem minimumDistance_appendixCode : minimumDistance appendixCode = 12 := by
  obtain ⟨mf, hweight⟩ := appendixMinimumWeight.2
  let b := BitVec.ofNat 8 mf.val
  let m := bitVecToWord b
  let c : appendixCode := ⟨appendixLinearMap m, ⟨m, rfl⟩⟩
  have hcweight : hammingNorm (c : BinaryWord 32) = 12 := by
    change hammingNorm (appendixLinearMap m) = 12
    rw [appendixLinearMap_bridge b, hammingNorm_bitVecToWord]
    exact hweight
  have hc0 : c ≠ 0 := by
    intro hc
    have hz' := congrArg
      (fun x : appendixCode => hammingNorm (x : BinaryWord 32)) hc
    have hz : hammingNorm (c : BinaryWord 32) = 0 := by simpa using hz'
    omega
  letI : Nontrivial appendixCode := ⟨⟨c, 0, hc0⟩⟩
  apply Nat.le_antisymm
  · simpa [hcweight] using minimumDistance_le_weight appendixCode c hc0
  · obtain ⟨d, hd0, hdweight⟩ := minimumDistance_attained appendixCode
    rw [← hdweight]
    exact appendixCode_weight_lower d hd0

end BAA
