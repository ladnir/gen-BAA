def rm25ProfileAdd (p q : RM25SparseProfile) : RM25SparseProfile :=
  match p, q with
  | (a0, a8, a12, a16, a20, a24, a32),
      (b0, b8, b12, b16, b20, b24, b32) =>
    (a0 + b0, a8 + b8, a12 + b12, a16 + b16,
      a20 + b20, a24 + b24, a32 + b32)

def rm25SummedExpectedProfile : RM25SparseProfile :=
  (List.finRange 256).foldl (fun counts hi =>
    rm25ProfileAdd counts (rm25ExpectedChunkProfile hi))
    (0, 0, 0, 0, 0, 0, 0)

set_option maxRecDepth 100000 in
theorem rm25WeightSpectrum :
    rm25SummedExpectedProfile = (1, 620, 13888, 36518, 13888, 620, 1) := by
  decide

