import BAA.RM25

/-!
# Kernel certificates for `RM(2,5)`

The hot encoder uses sixteen cached 32-bit evaluation rows and an unrolled XOR
kernel.  Messages are partitioned into 256 chunks of 256 words.
-/

namespace BAA

def rm25LiteralRow (j : Fin 16) : BitVec 32 :=
  match j.val with
  | 0 => BitVec.ofNat 32 0x7EE8E881
  | 1 => BitVec.ofNat 32 0x82282882
  | 2 => BitVec.ofNat 32 0x84484884
  | 3 => BitVec.ofNat 32 0x90606090
  | 4 => BitVec.ofNat 32 0x96006900
  | 5 => BitVec.ofNat 32 0x96690000
  | 6 => BitVec.ofNat 32 0x88888888
  | 7 => BitVec.ofNat 32 0xA0A0A0A0
  | 8 => BitVec.ofNat 32 0xAA00AA00
  | 9 => BitVec.ofNat 32 0xAAAA0000
  | 10 => BitVec.ofNat 32 0xC0C0C0C0
  | 11 => BitVec.ofNat 32 0xCC00CC00
  | 12 => BitVec.ofNat 32 0xCCCC0000
  | 13 => BitVec.ofNat 32 0xF000F000
  | 14 => BitVec.ofNat 32 0xF0F00000
  | _ => BitVec.ofNat 32 0xFF000000

/-- Every cached row is the evaluation of its declared degree-at-most-two
Boolean basis polynomial at the 32 Boolean points. -/
theorem rm25LiteralRow_correct :
    ∀ j : Fin 16, ∀ i : Fin 32,
      bitVecToWord (rm25LiteralRow j) i =
        rm25Basis (rm25OrderedIndex j) (fin32BinaryWord5Equiv i) := by
  intro j
  fin_cases j <;> intro i <;> fin_cases i <;> decide

def rm25Select (b : Bool) (row : BitVec 32) : BitVec 32 :=
  if b then row else BitVec.ofNat 32 0

/-- Allocation-free fixed-width encoder used by the exhaustive certificate. -/
def rm25Encode (m : BitVec 16) : BitVec 32 :=
  BitVec.xor (rm25Select (m.getLsbD 0) (rm25LiteralRow 0)) <|
  BitVec.xor (rm25Select (m.getLsbD 1) (rm25LiteralRow 1)) <|
  BitVec.xor (rm25Select (m.getLsbD 2) (rm25LiteralRow 2)) <|
  BitVec.xor (rm25Select (m.getLsbD 3) (rm25LiteralRow 3)) <|
  BitVec.xor (rm25Select (m.getLsbD 4) (rm25LiteralRow 4)) <|
  BitVec.xor (rm25Select (m.getLsbD 5) (rm25LiteralRow 5)) <|
  BitVec.xor (rm25Select (m.getLsbD 6) (rm25LiteralRow 6)) <|
  BitVec.xor (rm25Select (m.getLsbD 7) (rm25LiteralRow 7)) <|
  BitVec.xor (rm25Select (m.getLsbD 8) (rm25LiteralRow 8)) <|
  BitVec.xor (rm25Select (m.getLsbD 9) (rm25LiteralRow 9)) <|
  BitVec.xor (rm25Select (m.getLsbD 10) (rm25LiteralRow 10)) <|
  BitVec.xor (rm25Select (m.getLsbD 11) (rm25LiteralRow 11)) <|
  BitVec.xor (rm25Select (m.getLsbD 12) (rm25LiteralRow 12)) <|
  BitVec.xor (rm25Select (m.getLsbD 13) (rm25LiteralRow 13)) <|
  BitVec.xor (rm25Select (m.getLsbD 14) (rm25LiteralRow 14)) <|
    rm25Select (m.getLsbD 15) (rm25LiteralRow 15)

def rm25ChunkMessage (hi lo : Fin 256) : BitVec 16 :=
  BitVec.ofNat 16 (lo.val + 256 * hi.val)

def rm25ChunkIndex (block offset : Fin 16) : Fin 256 :=
  ⟨offset.val + 16 * block.val, by omega⟩

abbrev RM25SparseProfile := ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ

def rm25ProfileIncrement (p : RM25SparseProfile) (w : ℕ) : RM25SparseProfile :=
  match p with
  | (c0, c8, c12, c16, c20, c24, c32) =>
    if w = 0 then (c0 + 1, c8, c12, c16, c20, c24, c32)
    else if w = 8 then (c0, c8 + 1, c12, c16, c20, c24, c32)
    else if w = 12 then (c0, c8, c12 + 1, c16, c20, c24, c32)
    else if w = 16 then (c0, c8, c12, c16 + 1, c20, c24, c32)
    else if w = 20 then (c0, c8, c12, c16, c20 + 1, c24, c32)
    else if w = 24 then (c0, c8, c12, c16, c20, c24 + 1, c32)
    else if w = 32 then (c0, c8, c12, c16, c20, c24, c32 + 1)
    else p

def rm25ChunkProfile (hi : Fin 256) : RM25SparseProfile :=
  (List.finRange 256).foldl (fun counts lo =>
    rm25ProfileIncrement counts
      (bitVecWeight (rm25Encode (rm25ChunkMessage hi lo))))
    (0, 0, 0, 0, 0, 0, 0)

